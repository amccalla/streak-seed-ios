    "Widgets, smart nudges, and streak protection — so your habit actually sticks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets, smarte Erinnerungen und Streak-Schutz — damit deine Gewohnheit wirklich bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets, recordatorios inteligentes y protección de racha — para que tu hábito realmente perdure."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets, rappels intelligents et protection de série — pour que votre habitude tienne vraiment."
