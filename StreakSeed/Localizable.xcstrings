    "Cancel anytime. No backend. Your data stays on device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jederzeit kündbar. Kein Server. Deine Daten bleiben auf dem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela en cualquier momento. Sin servidor. Tus datos se quedan en el dispositivo."
